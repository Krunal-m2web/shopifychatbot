// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Merchant {
  id              String            @id @default(uuid()) @db.Uuid
  shopDomain      String            @unique @map("shop_domain")
  shopName        String?           @map("shop_name")
  accessToken     String            @map("access_token")
  settings        Json              @default("{}")
  widgetConfig    Json              @default("{\"primaryColor\":\"#2563EB\",\"position\":\"bottom-right\",\"welcomeMessage\":\"Hi! How can I help you today?\",\"botName\":\"Support Assistant\"}") @map("widget_config")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  conversations   Conversation[]
  escalations     Escalation[]
  analyticsEvents AnalyticsEvent[]

  @@map("merchants")
}

model Conversation {
  id            String       @id @default(uuid()) @db.Uuid
  merchantId    String       @map("merchant_id") @db.Uuid
  sessionId     String       @map("session_id")
  status        String       @default("active") // active | resolved | escalated
  customerEmail String?      @map("customer_email")
  customerName  String?      @map("customer_name")
  metadata      Json         @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  merchant      Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages      Message[]
  escalations   Escalation[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String       // user | assistant | system
  content        String       @db.Text
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Escalation {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  merchantId     String       @map("merchant_id") @db.Uuid
  reason         String
  summary        String?      @db.Text
  customerEmail  String?      @map("customer_email")
  customerPhone  String?      @map("customer_phone")
  status         String       @default("pending") // pending | in_progress | resolved
  createdAt      DateTime     @default(now()) @map("created_at")
  resolvedAt     DateTime?    @map("resolved_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  merchant       Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@map("escalations")
}

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  eventType  String   @map("event_type")
  eventData  Json     @default("{}") @map("event_data")
  createdAt  DateTime @default(now()) @map("created_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("analytics_events")
}
